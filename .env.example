# Скопируйте в .env и задайте значения
SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=sqlite:///graph_course.db
# Адрес отправителя для Outlook (боевой Windows-сервер СВА)
OUTLOOK_SENDER=
SESSION_LIFETIME_DAYS=3
# Контент курса. По умолчанию — каталог content/ в корне проекта.
# Раскомментируйте и задайте путь, только если нужно переопределить.
# COURSE_PLAN_PATH=
# COURSE_DOCX_DIR=
# COURSE_NB_DIR=
# Бэкап БД: каталог, период и количество хранимых копий
# (по умолчанию — backups/ в корне, раз в сутки, хранить 7 копий).
# BACKUP_DIR=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# BACKUP_FIRST_DELAY_SECONDS=5
